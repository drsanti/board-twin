{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "board-twin",
  "version": "0.1.0",
  "identifier": "com.drsanti.boardtwin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7393",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "board-twin",
        "width": 1024,
        "height": 720,
        "minWidth": 640,
        "minHeight": 480,
        "additionalBrowserArgs": "--autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
