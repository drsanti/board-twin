{
  "name": "@ternion/trn-ui",
  "version": "0.1.0",
  "description": "TERNION TRN React UI primitives for Bitstream Studio and external consumers",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./glb-scene-tree": {
      "types": "./src/glb-scene-tree/index.ts",
      "import": "./dist/glb-scene-tree/index.js",
      "default": "./dist/glb-scene-tree/index.js"
    },
    "./pie-menu": {
      "types": "./src/pie-menu/index.ts",
      "import": "./dist/pie-menu/index.js",
      "default": "./dist/pie-menu/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src/theme",
    "README.md"
  ],
  "scripts": {
    "build": "tsup && node scripts/bundle-styles.mjs",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.0",
    "clsx": "^2.1.1",
    "gsap": "^3.13.0",
    "lucide-react": "^0.546.0",
    "react-markdown": "^9.0.1",
    "react-syntax-highlighter": "^15.6.1",
    "tailwind-merge": "^3.3.1",
    "three": "^0.180.0",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.180.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.3"
  }
}
